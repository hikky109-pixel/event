from playwright.sync_api import sync_playwright
from bs4 import BeautifulSoup
import re
from datetime import datetime
import requests
import os
from dotenv import load_dotenv

# .env からWebhook URLを読み込む
load_dotenv()
WEBHOOK_URL = os.getenv("DISCORD_WEBHOOK_URL")

if not WEBHOOK_URL:
    print("❌ エラー: .envファイルにDISCORD_WEBHOOK_URLが設定されていません")
    exit(1)

# 今日の日付を自動取得
today = datetime.now()
TARGET_DATE = today.strftime("%Y%m%d")
weekday = ["月", "火", "水", "木", "金", "土", "日"][today.weekday()]

month = TARGET_DATE[4:6]
day = TARGET_DATE[6:8]

message = f"=== {month}月{day}日（{weekday}） ライブ情報 ===\n"
message += "（サンデーフォークのみ / ベータ版）\n\n"

events = []

with sync_playwright() as p:
    browser = p.chromium.launch(headless=True)
    page = browser.new_page()
    
    page.goto("https://www.sundayfolk.com/calendar/2026/05/", timeout=60000)
    page.wait_for_timeout(8000)
    
    html = page.content()
    soup = BeautifulSoup(html, "html.parser")
    
    block = soup.find("div", id=f"d{TARGET_DATE}")
    
    if block:
        table = block.find("table", class_="tableList")
        if table:
            rows = table.find_all("tr")[1:]
            
            for row in rows:
                cols = row.find_all("td")
                if len(cols) < 5:
                    continue
                    
                artist = cols[0].get_text(strip=True)
                venue = cols[3].get_text(strip=True)
                
                # 30文字で折り返し
                if len(venue) > 30:
                    venue = venue[:30] + "\n" + venue[30:]
                
                region_icon = cols[4].find("img")
                if not region_icon or region_icon.get("alt") != "名古屋":
                    continue
                
                if any(word in artist for word in ["【公演中止】", "【公演延期】", "中止", "延期"]):
                    continue
                
                link_tag = cols[1].find("a")
                if link_tag and link_tag.get("href"):
                    detail_url = "https://www.sundayfolk.com" + link_tag.get("href")
                    
                    page.goto(detail_url, timeout=30000)
                    page.wait_for_timeout(4000)
                    
                    detail_text = BeautifulSoup(page.content(), "html.parser").get_text()
                    
                    time_match = re.search(r"(\d{1,2}:\d{2}\s*\(\s*\d{1,2}:\d{2}\s*開場\))", detail_text)
                    if not time_match:
                        time_match = re.search(r"(\d{1,2}:\d{2}).*?\((\d{1,2}:\d{2}).*?開場", detail_text)
                    
                    time_info = time_match.group(0) if time_match else "時間情報なし"
                    
                    events.append({
                        "time": time_info,
                        "venue": venue,
                        "artist": artist
                    })

events.sort(key=lambda x: x["time"] if x["time"] != "時間情報なし" else "99:99")

message += f"**本日 合計: {len(events)}件**\n"
message += "-" * 30 + "\n\n"

for e in events:
    message += f"⏰ {e['time']}\n"
    message += f"📍 {e['venue']}\n"
    message += f"🎤 {e['artist']}\n"
    message += "-" * 30 + "\n\n"

# Discord送信
try:
    payload = {"content": message}
    response = requests.post(WEBHOOK_URL, json=payload, timeout=15)
    if response.status_code == 204:
        print("✅ Discordに投稿完了！")
    else:
        print(f"⚠️ 投稿失敗: {response.status_code}")
except Exception as e:
    print(f"❌ エラー: {e}")

print("終了しました。")
